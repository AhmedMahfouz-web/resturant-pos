# One private file per restaurant backend deployment. Do not commit real values.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://cafename.eminent-studio.com
APP_KEY=
TENANT_API_HOST=cafename.eminent-studio.com
FRONTEND_ORIGIN=https://maresto.eminent-studio.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_cafename
DB_USERNAME=pos_cafename
DB_PASSWORD=SET_A_UNIQUE_DATABASE_PASSWORD

JWT_SECRET=
# Four-digit PIN login is disabled on a public cloud endpoint by default.
ALLOW_PIN_LOGIN=false
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# A WebSocket server/process and internal port are needed per restaurant.
# The public reverse proxy serves WSS on the backend domain's port 443.
BROADCAST_DRIVER=websockets
PUSHER_APP_ID=cafename
PUSHER_APP_KEY=SET_PUBLIC_KEY_SHARED_WITH_FRONTEND
PUSHER_APP_SECRET=SET_A_UNIQUE_SECRET_FOR_THIS_RESTAURANT
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
LARAVEL_WEBSOCKETS_PORT=6001
